#!/usr/bin/env bash
#
# SUPER+W: close the smallest thing that is open, the way macOS cmd+w does.
#
# Hyprland's `killactive` is a COMPOSITOR-level close request. It closes the whole
# window and cannot see the tabs, splits or documents inside it. macOS cmd+w is
# APP-level, which is why it can walk a ladder: pane -> tab -> window, closing the
# window only when it is the last thing left. That difference is the entire reason
# SUPER+W feels like a worse cmd+w on Omarchy.
#
# This recovers the ladder by retyping the focused app's own close-smallest-unit
# shortcut into it, so the app decides what "close" means. Apps already implement
# the escalation; the compositor just has to stop pre-empting them.
#
# Deliberately a WHITELIST: only classes verified to implement the ladder get the
# keystroke, and anything unrecognised falls through to killactive. A wrong guess
# would otherwise make a window silently unclosable, which is far worse than the
# behaviour being replaced.
#
# See ADR-0014 and ADR-0020 in the dotfiles repo.

set -euo pipefail

class=$(hyprctl activewindow -j | jq -r '.class // empty')

case $class in
# ctrl+w inside a terminal is readline's delete-word (unix-word-rubout), so
# Ghostty puts close_surface on ctrl+shift+w instead. Sending plain ctrl+w here
# would silently eat a word off the command line rather than close anything.
com.mitchellh.ghostty)
  send="CTRL SHIFT, W"
  ;;
# Chromium (helium), Zed and GTK apps all close the innermost tab or document on
# ctrl+w, and close the window when it is the last one - the ladder, already built.
#
# chrome-* is every omarchy-launch-webapp window: chromium --app names the class
# after the host, e.g. chrome-chatgpt.com__-Profile_1, NOT after the browser. Those
# windows have no tab strip, so ctrl+w goes straight to the window rung - the same
# outcome as killactive, but taken by the app rather than the compositor.
helium | chrome-* | dev.zed.Zed | org.gnome.*)
  send="CTRL, W"
  ;;
# Unknown app: behave exactly as before.
*)
  [[ ${1-} == --dry-run ]] && {
    echo "class=${class:-<none>} -> killactive"
    exit 0
  }
  hyprctl dispatch killactive
  exit 0
  ;;
esac

if [[ ${1-} == --dry-run ]]; then
  echo "class=$class -> sendshortcut $send, activewindow"
  exit 0
fi

hyprctl dispatch sendshortcut "$send, activewindow"
