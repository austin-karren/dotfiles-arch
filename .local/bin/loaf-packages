#!/bin/bash

# loaf:summary=Diff the package manifest against what is installed
# loaf:args=[--quiet]

# Compares packages/chosen.packages (the decision) against pacman's idea of what
# is explicitly installed (the fact). Reports both directions: manifest entries
# that are missing, and packages installed but never written down.
#
# Deliberately does not install anything. Removing a package should be a decision
# recorded in the manifest first, not a side effect of running a check.

set -uo pipefail

# $LOAF_HOME is $HOME everywhere except the test suite, which points it at a
# fixture tree. Every path below derives from it, so nothing reaches the real
# home directory unless it was asked to.
LOAF_HOME="${LOAF_HOME:-$HOME}"
LOAF_ROOT="${LOAF_ROOT:-$LOAF_HOME/dotfiles-arch}"
MANIFEST="$LOAF_ROOT/packages/chosen.packages"
quiet=false
[[ ${1:-} == --quiet ]] && quiet=true

if [[ ! -f $MANIFEST ]]; then
  $quiet || echo "loaf: no manifest at $MANIFEST" >&2
  exit 1
fi

# Strip comments and blanks.
mapfile -t chosen < <(sed -e 's/#.*//' -e '/^[[:space:]]*$/d' -e 's/[[:space:]]//g' "$MANIFEST" | sort -u)

missing=()
for p in "${chosen[@]}"; do
  pacman -Qq "$p" &>/dev/null || missing+=("$p")
done

if ((${#missing[@]} == 0)); then
  $quiet && exit 0
  printf '\033[32m✓\033[0m all %d chosen packages installed\n' "${#chosen[@]}"
else
  $quiet && exit 1
  printf '\033[31m✗\033[0m %d chosen package(s) not installed:\n' "${#missing[@]}"
  printf '    %s\n' "${missing[@]}"
  printf '\n  sudo pacman -S --needed %s\n' "${missing[*]}"
fi

$quiet && exit 0

# The other direction is advisory, not a failure: most explicitly-installed
# packages are CachyOS base and Omarchy dependencies, not choices. Only worth
# surfacing when the record has grown since it was last regenerated.
if [[ -f $LOAF_ROOT/packages.txt ]]; then
  untracked=$(comm -13 <(sort -u "$LOAF_ROOT/packages.txt") <(pacman -Qqe | sort -u) | wc -l)
  if ((untracked)); then
    printf '\n\033[33m!\033[0m %d package(s) installed since packages.txt was regenerated\n' "$untracked"
    printf '    refresh the record:  pacman -Qqe > %s/packages.txt\n' "${LOAF_ROOT/#$LOAF_HOME/\~}"
  fi
fi
