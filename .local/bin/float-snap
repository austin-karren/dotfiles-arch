#!/usr/bin/env bash
#
# Place a FLOATING window into a half, fill the usable area, or centre it.
# See ADR-0024.
#
#   float-snap left | right | up | down    snap to half / fill
#   float-snap center                      centre, keeping the current size
#   float-snap --usable-area               print "LW LH X0 Y0 UW UH" (used by window-resize)
#
# WHY THIS NEEDS A PROBE
#
# Placement needs the monitor's LOGICAL size, and hyprctl will not give it accurately:
# it rounds the scale. This machine runs `1.666667` per monitors.conf, which hyprctl
# reports as `1.67`, so width/scale yields 2299.4 where the truth is 2304 - a ~5px
# error. Small, but it lands entirely in one margin: two half-snapped windows would sit
# 8px from the left edge and 12.6px from the right, which is exactly the kind of
# asymmetry this bar and layout are otherwise tuned to avoid.
#
# Hyprland itself computes `exact N%` correctly, so the logical size is obtained by
# asking it for 100% once and reading the result back. That answer is cached per
# monitor and resolution, so the probe runs once rather than on every keypress.
#
# The probe requires a floating window, which is the only case this script handles.

set -euo pipefail

CACHE="$HOME/.local/state/omarchy/hypr-logical-size"
# Outer margin and the divider between two halves. Both gaps_out so the result reads
# as evenly spaced as a tiled layout, rather than matching tiled gaps exactly (which
# also involve gaps_in and borders).
GAP=$(hyprctl getoption general:gaps_out -j | jq -r '.custom // .int' | awk '{print $1+0}')
[[ $GAP =~ ^[0-9]+$ ]] || GAP=8

active=$(hyprctl activewindow -j)
[[ -n $(jq -r '.address // empty' <<<"$active") ]] || exit 0
[[ $(jq -r '.floating' <<<"$active") == true ]] || exit 0

mon_id=$(jq -r '.monitor' <<<"$active")
# .monitor is the numeric id, not the name - see ADR-0013 for the same trap.
mon=$(hyprctl monitors -j | jq -c --argjson m "$mon_id" '.[] | select(.id == $m)')
[[ -n $mon ]] || {
  echo "float-snap: no monitor with id $mon_id" >&2
  exit 1
}

read -r mon_name mx my pw ph rl rt rr rb < <(
  jq -r '"\(.name) \(.x) \(.y) \(.width) \(.height) \(.reserved[0]) \(.reserved[1]) \(.reserved[2]) \(.reserved[3])"' <<<"$mon"
)
key="$mon_name:${pw}x${ph}"

logical_size() {
  local lw lh
  if [[ -f $CACHE ]]; then
    read -r lw lh < <(awk -v k="$key" '$1 == k { print $2, $3; exit }' "$CACHE") || true
    [[ -n ${lw:-} ]] && {
      echo "$lw $lh"
      return
    }
  fi
  # Probe: Hyprland resolves the percentage against the true logical size.
  hyprctl dispatch resizeactive exact 100% 100% >/dev/null
  read -r -t 0.08 -u 9 9<> <(:) || true
  read -r lw lh < <(hyprctl activewindow -j | jq -r '"\(.size[0]) \(.size[1])"')
  mkdir -p "$(dirname "$CACHE")"
  printf '%s\t%s\t%s\n' "$key" "$lw" "$lh" >>"$CACHE"
  echo "$lw $lh"
}

read -r LW LH < <(logical_size)

x0=$((mx + rl + GAP))
y0=$((my + rt + GAP))
uw=$((LW - rl - rr - 2 * GAP))
uh=$((LH - rt - rb - 2 * GAP))
half_w=$(((uw - GAP) / 2))
half_h=$(((uh - GAP) / 2))

case ${1-} in
--usable-area)
  echo "$LW $LH $x0 $y0 $uw $uh"
  exit 0
  ;;
# centerwindow already keeps the size and already accounts for the reserved area -
# it offsets by the bar rather than centring on the raw monitor. Nothing to compute.
center)
  hyprctl dispatch centerwindow >/dev/null
  exit 0
  ;;
left) x=$x0 y=$y0 w=$half_w h=$uh ;;
right)
  x=$((x0 + half_w + GAP)) y=$y0 w=$half_w h=$uh
  ;;
up) x=$x0 y=$y0 w=$uw h=$uh ;;
down)
  x=$x0 y=$((y0 + half_h + GAP)) w=$uw h=$half_h
  ;;
*)
  echo "usage: float-snap left|right|up|down|center|--usable-area" >&2
  exit 1
  ;;
esac

# Resize first: `resizeactive exact` resizes around the window's own centre, so the
# position it leaves behind is meaningless until the move lands.
hyprctl dispatch resizeactive exact "$w" "$h" >/dev/null
hyprctl dispatch moveactive exact "$x" "$y" >/dev/null
