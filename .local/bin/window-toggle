#!/bin/bash
# Toggle a window by class: close it if it exists, otherwise run the launch command.
#
# Usage: window-toggle <window-class> <launch-command...>
#
# Exists because Omarchy's waybar modules call omarchy-launch-or-focus-tui, which by
# design FOCUSES an existing window rather than dismissing it. Clicking the tray icon
# of an already-open panel then appears to do nothing (the window was usually already
# focused, since waybar takes no keyboard focus), instead of closing it.
#
# Deliberately simpler than ~/.local/bin/menu-toggle: no grace window is needed here.
# That one guards against walker layer-surfaces tearing themselves down on button
# PRESS while waybar dispatches on button RELEASE. These are ordinary floating
# toplevels that stay put when they lose focus, so there is no race to lose.
#
# Closing rather than hiding is intentional: bluetui and impala are cheap to restart,
# and they poll live hardware state, so a stale hidden copy would be worse than a
# fresh one. Contrast ~/.local/bin/calendar-toggle, which hides GNOME Calendar on a
# special workspace precisely because it is expensive to start.

set -u

if (($# < 2)); then
  echo "Usage: window-toggle <window-class> <launch-command...>" >&2
  exit 1
fi

CLASS="$1"
shift

ADDR=$(hyprctl clients -j | jq -r --arg c "$CLASS" '.[] | select(.class == $c) | .address' | head -n1)

if [[ -n $ADDR ]]; then
  hyprctl dispatch closewindow "address:$ADDR" >/dev/null
else
  exec setsid "$@"
fi
