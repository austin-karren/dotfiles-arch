#!/bin/bash

# Raycast-style system command palette, bound to SUPER+CTRL+SPACE.
#
# Everything here is an existing Omarchy command; this just gathers the ones
# worth reaching for in one keystroke instead of hunting through submenus.
#
# Uses the same walker --dmenu invocation as omarchy-menu so it looks native.

CURRENT_THEME_DIR="$HOME/.config/omarchy/current/theme"

# Written as escapes rather than literal glyphs: pasting Nerd Font characters
# straight into a file is lossy through some editors, which silently leaves the
# entry with no icon. Codepoints are Material Design Icons (nf-md-*).
ICON_EMOJI=$'\U000F01F2' # emoticon
ICON_THEME=$'\U000F03D8' # palette (F0479 is an SD card, not a palette)
ICON_LOCK=$'\U000F033E'  # lock

# Pressing the bind again while a menu is open should dismiss it, matching
# omarchy-menu's behaviour rather than stacking a second palette.
if pgrep -f "walker.*--dmenu" >/dev/null; then
  walker --close >/dev/null 2>&1
  exit 0
fi

menu() {
  local prompt="$1" options="$2"
  # No --width/--minheight/--maxheight: omarchy-launch-walker already applies
  # 644/300/300, so the palette matches the app launcher exactly.
  echo -e "$options" | omarchy-launch-walker --dmenu -p "$prompt…" 2>/dev/null
}

# Label the appearance entry with where it will take you, not where you are.
if [[ -f "$CURRENT_THEME_DIR/light.mode" ]]; then
  appearance="󰖔  Switch to Dark"
else
  appearance="󰖨  Switch to Light"
fi

options="$appearance"
options="$options\n${ICON_EMOJI}  Emoji & Symbols"
options="$options\n󰅍  Clipboard History"
options="$options\n󰸉  Wallpaper"
options="$options\n${ICON_THEME}  Theme"
options="$options\n󱄄  Screensaver"
options="$options\n${ICON_LOCK}  Lock"

# Suspend can be disabled system-wide; hibernate depends on swap being set up.
omarchy-toggle-enabled suspend-off || options="$options\n󰒲  Sleep"
omarchy-hibernation-available 2>/dev/null && options="$options\n󰤁  Hibernate"

options="$options\n󰍃  Log Out"
options="$options\n󰜉  Restart"
options="$options\n󰐥  Shut Down"

case $(menu "System" "$options") in
*"Switch to Dark"* | *"Switch to Light"*) toggle-appearance ;;
*"Emoji & Symbols"*) omarchy-launch-walker -m symbols ;;
*"Clipboard History"*) omarchy-launch-walker -m clipboard ;;
*Wallpaper*) omarchy-menu background ;;
*Theme*) omarchy-menu theme ;;
*Screensaver*) omarchy-launch-screensaver force ;;
*Lock*) omarchy-system-lock ;;
*Sleep*) systemctl suspend ;;
*Hibernate*) systemctl hibernate ;;
*"Log Out"*) omarchy-system-logout ;;
*Restart*) omarchy-system-reboot ;;
*"Shut Down"*) omarchy-system-shutdown ;;
esac
