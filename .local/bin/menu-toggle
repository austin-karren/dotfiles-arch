#!/bin/bash
# Open the Omarchy menu, or close it if it is already showing.
#
# Why this wrapper exists
# ----------------------------------------------------------------------------
# omarchy-menu already has toggle_existing_menu(): it pgreps for a live
# `walker --dmenu` and calls `walker --close`. Invoked twice from a shell that
# genuinely works (verified). It is not enough for a waybar CLICK, because:
#
#   * waybar fires on-click from a GTK click gesture, which completes on button
#     RELEASE, and
#   * walker can already be tearing down from having lost focus on button PRESS.
#
# So by the time the handler runs there may be no walker process left to find, the
# pgrep comes back empty, and the menu is immediately reopened -- indistinguishable
# from "the second click did nothing".
#
# Fix: remember when the menu last went away and refuse to reopen inside a short
# grace window. A click that merely dismissed the menu therefore stays a dismissal.
#
# Matching note: candidates from `pgrep -f` are confirmed against /proc/PID/comm.
# `pgrep -f` matches whole command lines, so any shell whose text merely CONTAINS
# the pattern matches too -- including this script's own callers. That is not
# hypothetical: it made omarchy-menu close a menu that was never open, and killed
# two shells outright during development.

GRACE_MS=400
STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/menu-toggle"
STAMP="$STATE_DIR/last-close"
mkdir -p "$STATE_DIR"

now_ms() { echo $(( $(date +%s%N) / 1000000 )); }

menu_pids() {
  local p
  for p in $(pgrep -f 'walker.*--dmenu' 2>/dev/null); do
    [[ "$(cat /proc/$p/comm 2>/dev/null)" == walker ]] && echo "$p"
  done
}

# 1. Menu is up -> close it and record when.
if [[ -n "$(menu_pids)" ]]; then
  walker --close >/dev/null 2>&1
  now_ms >"$STAMP"
  exit 0
fi

# 2. Menu vanished a moment ago -> this invocation is the tail end of the same click
#    that dismissed it. Swallow it rather than reopening.
if [[ -f $STAMP ]]; then
  last=$(<"$STAMP")
  if [[ $last =~ ^[0-9]+$ ]] && (( $(now_ms) - last < GRACE_MS )); then
    exit 0
  fi
fi

# 3. Nothing showing -> open it. Stamp on the way out, whatever closed it, so the
#    release half of a dismissing click lands in the grace window above.
trap 'now_ms >"$STAMP"' EXIT
omarchy-menu "$@"
