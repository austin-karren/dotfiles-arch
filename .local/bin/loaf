#!/bin/bash

# loaf:summary=Manage this machine's deviations from stock Omarchy

# Dispatches `rice <command>` to a `rice-<command>` executable on PATH, the same
# way the `omarchy` CLI dispatches to `omarchy-*`. Commands are discovered at run
# time rather than listed here, so adding a script to ~/.local/bin is all it takes
# for it to appear in the help below — it just needs a `# loaf:summary=` line.

set -euo pipefail

# $LOAF_HOME is $HOME everywhere except the test suite, which points it at a
# fixture tree. Every path below derives from it, so nothing reaches the real
# home directory unless it was asked to.
LOAF_HOME="${LOAF_HOME:-$HOME}"
LOAF_ROOT="${LOAF_ROOT:-$LOAF_HOME/shokupan}"
export LOAF_ROOT

summary_of() {
  # Read the summary without executing the script.
  sed -n 's/^# loaf:summary=//p' "$1" | head -1
}

list_commands() {
  echo "Manage this machine's deviations from stock Omarchy."
  echo
  echo "Usage: loaf <command> [args]"
  echo

  local seen=() name path
  # Walk PATH rather than one fixed directory, so a command still resolves if it
  # is installed somewhere other than ~/.local/bin.
  while IFS= read -r path; do
    name=${path##*/loaf-}
    [[ " ${seen[*]:-} " == *" $name "* ]] && continue
    seen+=("$name")
    printf '  %-10s %s\n' "$name" "$(summary_of "$path")"
  done < <(compgen -c 'loaf-' | sort -u | while read -r c; do command -v "$c"; done)

  echo
  echo "Repo: $LOAF_ROOT"
}

case "${1:-}" in
"" | -h | --help | help)
  list_commands
  exit 0
  ;;
esac

command=$1
shift

if ! command -v "loaf-$command" &>/dev/null; then
  echo "loaf: no such command '$command'" >&2
  echo "Run 'loaf' to list what exists." >&2
  exit 1
fi

exec "loaf-$command" "$@"
