#!/bin/bash

# Waybar is unsupervised under Omarchy: hyprland's autostart starts it with
# `uwsm-app -- waybar`, which lands in a transient systemd *scope*
# (app-Hyprland-waybar-*.scope). Scopes carry no Restart= policy, so when waybar
# segfaults - e.g. GTK3/GDK crashing while reloading cursors on a theme change -
# the bar silently disappears until it is started by hand.
#
# Poll for it and bring it back, while respecting the waybar-off toggle
# (SUPER+SHIFT+SPACE) so an intentional hide is never fought.

INTERVAL=5      # seconds between checks
SETTLE=5        # grace period after a relaunch before checking again
MAX_RESTARTS=5  # give up if it crash-loops this many times...
WINDOW=300      # ...within this many seconds

restarts=()

while sleep "$INTERVAL"; do
  # Intentionally hidden by the user - leave it alone.
  omarchy-toggle-enabled waybar-off && continue

  # Running fine - nothing to do.
  pgrep -x waybar >/dev/null && continue

  # Drop restart timestamps that have aged out of the window.
  now=$(date +%s)
  pruned=()
  for t in "${restarts[@]}"; do
    (( now - t < WINDOW )) && pruned+=("$t")
  done
  restarts=("${pruned[@]}")

  # Crash loop: respawning is not helping, so stop and say so rather than
  # spinning forever in the background.
  if (( ${#restarts[@]} >= MAX_RESTARTS )); then
    notify-send -u critical "Waybar keeps crashing" \
      "Restarted ${#restarts[@]}x in $((WINDOW / 60))min. Watchdog stopping. Check: coredumpctl list waybar"
    exit 1
  fi

  restarts+=("$now")
  setsid uwsm-app -- waybar >/dev/null 2>&1 &
  sleep "$SETTLE"
done
